<script>
// CONFIGURAÇÃO SUPABASE
const SUPABASE_URL = "https://hminkpxieanfifflqkfs.supabase.co";
// IMPORTANTE: mantenha aqui a chave PUBLICÁVEL (anon/publicable) do projeto Supabase.
const SUPABASE_KEY = "sb_publishable_QmPOBFsG4h4GsFj_6I8Swg_TZFPXqcr";

if(!window.supabase || typeof window.supabase.createClient!=='function'){
 const area=document.getElementById('servicos');
 const mensagem='<div class="service-card"><h3>Conexão temporariamente indisponível</h3><p>Não foi possível carregar o módulo de agendamento. Verifique a internet e tente novamente.</p><button class="btn" type="button" onclick="location.reload()">TENTAR NOVAMENTE</button></div>';
 if(area) area.innerHTML=mensagem;
 console.error('Supabase JS SDK não carregou. Os endereços CDN foram tentados, mas nenhum disponibilizou a biblioteca.');
 throw new Error('Supabase JS SDK não carregou.');
}
const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

let servicos = [];
let horarios = [];
let horarioEscolhido = null;
let reservaAtual = null;
let configuracoes = {};

const $ = id => document.getElementById(id);

function dataLocal(){
 const d = new Date();
 return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,10);
}

async function iniciar(){
 $('data').min = dataLocal();
 try{
  const results = await Promise.allSettled([
   db.from('services').select('*').eq('active',true).order('name'),
   db.from('business_hours').select('*').eq('active',true).order('weekday').order('available_time'),
   db.from('site_settings').select('*').limit(1).maybeSingle()
  ]);
  const s = results[0].status==='fulfilled' ? results[0].value : {data:null,error:results[0].reason};
  const h = results[1].status==='fulfilled' ? results[1].value : {data:null,error:results[1].reason};
  const c = results[2].status==='fulfilled' ? results[2].value : {data:null,error:results[2].reason};
  if(s.error) console.error('Erro ao carregar serviços:',s.error);
  if(h.error) console.error('Erro ao carregar horários:',h.error);
  if(c.error) console.error('Erro ao carregar configurações:',c.error);
  servicos = s.data || [];
  horarios = h.data || [];
  configuracoes = c.data || {};
  mostrarServicos();
  mostrarOpcoes();
  atualizarDadosPix();
  await carregarGaleria();
  if(c.data?.site_name) document.title = c.data.site_name + ' | Nail Designer';
  if(s.error){
   console.error('Detalhe técnico do Supabase (services):',s.error);
   $('servicos').innerHTML='<div class="service-card"><h3>Não foi possível carregar os serviços</h3><p>O site abriu, mas o Supabase não liberou a leitura da tabela de serviços. Confira a tabela services e a política de leitura pública (RLS) no Supabase.</p><button class="btn" type="button" onclick="iniciar()">TENTAR NOVAMENTE</button></div>';
  } else if(!servicos.length){
   $('servicos').innerHTML='<div class="service-card"><h3>Serviços em breve</h3><p>Anna ainda não cadastrou serviços ativos. Acesse a área administrativa para cadastrar.</p></div>';
  }
 }catch(err){
  console.error(err);
  $('servicos').innerHTML='<div class="service-card"><h3>Falha ao conectar</h3><p>Não foi possível acessar os serviços agora. Verifique sua conexão e tente novamente.</p><button class="btn" type="button" onclick="iniciar()">TENTAR NOVAMENTE</button></div>';
 }
}

function mostrarServicos(){
 $('servicos').innerHTML = '';
 $('servico').innerHTML = '<option value="">Selecione um serviço</option>';
 servicos.forEach(s=>{
  const card=document.createElement('button');
  card.type='button';
  card.className='service-card';
  card.style.textAlign='left';
  card.style.width='100%';
  const mark=document.createElement('div');mark.className='service-mark';mark.textContent='✦';
  const title=document.createElement('h3');title.textContent=s.name;
  const desc=document.createElement('p');desc.textContent='Atendimento com cuidado e atenção aos detalhes.';
  const price=document.createElement('strong');price.className='preco';
  price.textContent='R$ '+Number(s.price).toFixed(2).replace('.',',');
  const choose=document.createElement('span');choose.className='choose-service';choose.textContent='ESCOLHER ESTE SERVIÇO →';
  card.append(mark,title,desc,price,choose);
  card.onclick=()=>{ $('servico').value=String(s.id); atualizarResumo(); $('agendamento').scrollIntoView({behavior:'smooth'}); };
  $('servicos').append(card);
  const op=document.createElement('option');op.value=s.id;
  op.textContent=s.name+' - R$ '+Number(s.price).toFixed(2).replace('.',',');
  $('servico').append(op);
 });
}

function mostrarOpcoes(){
 if(!servicos.length) $('servicos').innerHTML='<div class="service-card"><h3>Serviços em breve</h3><p>Nenhum serviço cadastrado no momento.</p></div>';
}

$('data').addEventListener('change', carregarHorarios);
$('servico').addEventListener('change', atualizarResumo);

function atualizarResumo(){
 const s=servicos.find(x=>x.id===$('servico').value);
 if(!s){$('resumo').classList.add('hidden');return}
 $('resumo').classList.remove('hidden');
 $('resumo').textContent='Serviço: '+s.name+' | Valor: R$ '+Number(s.price).toFixed(2).replace('.',',');
}

async function carregarHorarios(){
 horarioEscolhido=null;
 $('horarios').innerHTML='<p class="small">Carregando...</p>';
 const data=$('data').value;
 if(!data)return;
 if(data<dataLocal()){$('horarios').textContent='Escolha uma data futura.';return}
 const {data:disponiveis,error}=await db.rpc('get_available_appointment_times',{p_date:data});
 if(error){
  console.error('Erro ao consultar horários disponíveis:',error);
  $('horarios').textContent='Não foi possível consultar os horários agora. Tente novamente.';
  return;
 }
 $('horarios').innerHTML='';
 (disponiveis||[]).forEach(item=>{
  const hora=String(item.available_time).slice(0,5);
  const b=document.createElement('button');
  b.type='button';
  b.textContent=hora;
  b.onclick=()=>{
   horarioEscolhido=hora;
   document.querySelectorAll('.horarios button').forEach(x=>x.classList.remove('selecionado'));
   b.classList.add('selecionado');
  };
  $('horarios').append(b);
 });
 if(!$('horarios').children.length)$('horarios').textContent='Todos os horários estão reservados ou indisponíveis.';
}

let enviandoReserva = false;
async function reservar(){
 if(enviandoReserva) return;
 const nome=$('nome').value.trim();
 const telefone=$('telefone').value.trim();
 const servico=servicos.find(s=>s.id===$('servico').value);
 const data=$('data').value;
 if(!nome||!telefone||!servico||!data||!horarioEscolhido){alert('Preencha todos os campos e escolha um horário.');return}
 if(data<dataLocal()){alert('Escolha uma data futura.');return}
 enviandoReserva=true;
 const botaoReserva=document.querySelector('#agendamento .booking-card > .btn');
 if(botaoReserva){botaoReserva.disabled=true;botaoReserva.textContent='PROCESSANDO...';}
 try{
  const {data:resultado,error}=await db.rpc('create_appointment',{
   p_customer_name:nome,
   p_customer_phone:telefone,
   p_service_id:servico.id,
   p_appointment_date:data,
   p_appointment_time:horarioEscolhido
  });
  if(error)throw error;
  const novo=Array.isArray(resultado)?resultado[0]:resultado;
  if(!novo?.id){throw new Error('A função de agendamento não retornou o identificador da reserva.');}
  reservaAtual={id:novo.id,expires_at:novo.expires_at,customer_name:nome,customer_phone:telefone,service_name:servico.name,price:servico.price};
  $('pagamento').classList.remove('hidden');
  $('statusPagamento').textContent='Reserva pendente. Você tem até o horário indicado para efetuar o Pix.';
  $('pagamento').scrollIntoView({behavior:'smooth'});
  iniciarContagem();
  await carregarHorarios();
 }catch(error){
  console.error('Erro ao criar agendamento:',error);
  alert(error.message||'Não foi possível reservar. Atualize os horários e tente novamente.');
  await carregarHorarios();
 }finally{
  enviandoReserva=false;
  if(botaoReserva){botaoReserva.disabled=false;botaoReserva.textContent='CONFIRMAR AGENDAMENTO';}
 }
}

let temporizador;
function iniciarContagem(){
 clearInterval(temporizador);
 temporizador=setInterval(async()=>{
  if(!reservaAtual)return;
  const {data,error}=await db.rpc('get_public_appointment_status',{p_appointment_id:reservaAtual.id});
  if(error){console.error('Não foi possível atualizar o status da reserva:',error);return;}
  const status=Array.isArray(data)?data[0]:data;
  if(!status)return;
  if(status.payment_status==='paid'||status.status==='confirmed'){
   $('statusPagamento').textContent='Pagamento confirmado! Seu horário está confirmado.';
   clearInterval(temporizador);return;
  }
  if(status.expires_at && new Date(status.expires_at).getTime()<=Date.now()){
   $('statusPagamento').textContent='O prazo da reserva terminou. Consulte os horários novamente.';
   clearInterval(temporizador);await carregarHorarios();
  }
 },5000);
}

async function copiarPix(){
 const chave=String(configuracoes.pix_key||'+5511954556081').trim();
 try{
  if(navigator.clipboard && window.isSecureContext){await navigator.clipboard.writeText(chave);}
  else{
   const campo=document.createElement('textarea');campo.value=chave;campo.setAttribute('readonly','');
   campo.style.position='fixed';campo.style.opacity='0';document.body.appendChild(campo);campo.select();
   const ok=document.execCommand('copy');campo.remove();if(!ok)throw new Error('copy failed');
  }
  alert('Chave Pix copiada!');
 }catch(e){prompt('Copie a chave Pix:',chave);}
}

function whatsappPagamento(){
 if(!reservaAtual)return;
 const numero=String(configuracoes.whatsapp_number||'5511954556081').replace(/\D/g,'');
 const mensagem='Olá, Anna! Acabei de realizar o pagamento Pix do meu agendamento. Meu nome é '+reservaAtual.customer_name+'.';
 window.open('https://wa.me/'+numero+'?text='+encodeURIComponent(mensagem),'_blank');
}

// PAINEL ADMINISTRATIVO
async function entrarAdmin(){
 const email=$('emailAdmin').value.trim();
 const senha=$('senhaAdmin').value;
 if(!email||!senha){alert('Informe e-mail e senha.');return}
 const {error}=await db.auth.signInWithPassword({email,password:senha});
 if(error){alert('Não foi possível entrar. Confira seu acesso administrativo.');return}
 $('login').classList.add('hidden');
 $('painel').classList.remove('hidden');
 carregarAdmin();
 listarServicosAdmin();
 listarGaleriaAdmin();
}

async function carregarAdmin(){
 const {data,error}=await db.from('appointments').select('*,services(name,price)')
  .order('appointment_date',{ascending:true}).order('appointment_time',{ascending:true});
 if(error){alert('Erro ao carregar agendamentos. Verifique as permissões.');console.error(error);return}
 $('listaAdmin').innerHTML='';
 (data||[]).forEach(a=>{
  const div=document.createElement('div');div.className='card';
  const titulo=document.createElement('strong');titulo.textContent=a.customer_name+' - '+(a.services?.name||'Serviço');
  const detalhes=document.createElement('p');
  detalhes.textContent='Data: '+a.appointment_date+' | Horário: '+String(a.appointment_time).slice(0,5)+' | WhatsApp: '+a.customer_phone+' | Pagamento: '+a.payment_status;
  const confirmar=document.createElement('button');confirmar.className='btn';confirmar.textContent='CONFIRMAR PAGAMENTO';
  confirmar.onclick=()=>atualizarReserva(a.id,{status:'confirmed',payment_status:'paid'});
  const cancelar=document.createElement('button');cancelar.className='btn';cancelar.textContent='CANCELAR RESERVA';
  cancelar.onclick=()=>atualizarReserva(a.id,{status:'cancelled',payment_status:'cancelled'});
  div.append(titulo,detalhes,confirmar,cancelar);$('listaAdmin').append(div);
 });
}

async function atualizarReserva(id,alteracoes){
 const {error}=await db.from('appointments').update(alteracoes).eq('id',id);
 if(error){alert('Não foi possível atualizar. Verifique as permissões.');console.error(error);return}
 alert('Agendamento atualizado.');carregarAdmin();
}

async function sairAdmin(){
 await db.auth.signOut();
 $('painel').classList.add('hidden');
 $('login').classList.remove('hidden');
}


function atualizarDadosPix(){
 const chave=String(configuracoes.pix_key||'+5511954556081');
 const visivel=$('pixPublicKey');if(visivel)visivel.textContent=chave;
 const wpp=String(configuracoes.whatsapp_number||'5511954556081').replace(/\D/g,'');
 const falar=document.querySelector('#pix-info a[href^="https://wa.me/"]');
 if(falar && wpp) falar.href='https://wa.me/'+wpp+'?text='+encodeURIComponent('Olá, Anna! Gostaria de informações sobre agendamento.');
}

async function adicionarServico(){
 const nome=$('novoServicoNome').value.trim();
 const preco=Number(String($('novoServicoPreco').value).replace(',','.'));
 if(!nome||!Number.isFinite(preco)||preco<0){alert('Informe o nome e um preço válido.');return;}
 const {error}=await db.from('services').insert({name:nome,price:preco,active:true});
 if(error){console.error(error);alert('Não foi possível cadastrar. Verifique as permissões de gravação da tabela services no Supabase.');return;}
 $('novoServicoNome').value='';$('novoServicoPreco').value='';
 alert('Serviço cadastrado!');await iniciar();listarServicosAdmin();
}

async function listarServicosAdmin(){
 const area=$('adminServicos');if(!area)return;
 const {data,error}=await db.from('services').select('*').order('name');
 if(error){area.textContent='Não foi possível listar serviços. Verifique as permissões.';return;}
 area.innerHTML='';
 (data||[]).forEach(s=>{
  const row=document.createElement('div');row.className='admin-service-row';
  const label=document.createElement('span');label.textContent=s.name+' — R$ '+Number(s.price).toFixed(2).replace('.',',')+(s.active?' · Ativo':' · Inativo');
  const toggle=document.createElement('button');toggle.type='button';toggle.className='btn';toggle.textContent=s.active?'DESATIVAR':'ATIVAR';
  toggle.onclick=async()=>{
   const {error}=await db.from('services').update({active:!s.active}).eq('id',s.id);
   if(error){alert('Não foi possível alterar o serviço. Verifique as permissões.');return;}
   await iniciar();listarServicosAdmin();
  };
  row.append(label,toggle);area.append(row);
 });
}

async function carregarGaleria(){
 const area=document.querySelector('.gallery-grid');
 if(!area)return;
 const {data,error}=await db.from('gallery').select('id,image_url,caption,active,sort_order').eq('active',true).order('sort_order').order('created_at');
 if(error){console.error('Erro ao carregar galeria:',error);return;}
 // Se ainda não houver fotos cadastradas, preserva as imagens demonstrativas já existentes.
 if(!data||!data.length)return;
 area.innerHTML='';
 data.forEach(item=>{
  const figure=document.createElement('figure');figure.className='gallery-item';
  const img=document.createElement('img');img.src=item.image_url;img.alt=item.caption||'Trabalho de Anna Gabrielly';img.loading='lazy';
  const caption=document.createElement('figcaption');caption.textContent=item.caption||'Arte em cada detalhe';
  figure.append(img,caption);area.append(figure);
 });
}

async function uploadFotosGaleria(){
 const input=$('annaGalleryFiles');
 const files=Array.from(input?.files||[]);
 if(!files.length){alert('Selecione pelo menos uma foto.');return;}
 const {data:sessionData}=await db.auth.getSession();
 if(!sessionData?.session){alert('Entre na área administrativa antes de enviar fotos.');return;}
 const legenda=$('annaGalleryCaption').value.trim();
 const botao=document.querySelector('#adminSiteManager button[onclick="uploadFotosGaleria()"]');
 if(botao){botao.disabled=true;botao.textContent='ENVIANDO...';}
 try{
  for(let i=0;i<files.length;i++){
   const file=files[i];
   if(!file.type.startsWith('image/'))throw new Error('Um dos arquivos selecionados não é uma imagem.');
   if(file.size>8*1024*1024)throw new Error('Cada foto deve ter no máximo 8 MB.');
   const ext=(file.name.split('.').pop()||'jpg').toLowerCase().replace(/[^a-z0-9]/g,'')||'jpg';
   const path='gallery/'+Date.now()+'-'+i+'-'+Math.random().toString(36).slice(2)+'.'+ext;
   const {error:uploadError}=await db.storage.from('site-assets').upload(path,file,{upsert:false,contentType:file.type});
   if(uploadError)throw uploadError;
   const {data:urlData}=db.storage.from('site-assets').getPublicUrl(path);
   const {error:insertError}=await db.from('gallery').insert({image_url:urlData.publicUrl,caption:legenda||file.name.replace(/\.[^.]+$/,''),active:true,sort_order:Date.now()+i});
   if(insertError)throw insertError;
  }
  input.value='';$('annaGalleryCaption').value='';
  alert('Fotos adicionadas à galeria!');
  await carregarGaleria();await listarGaleriaAdmin();
 }catch(error){
  console.error('Erro ao enviar fotos:',error);
  alert('Não foi possível concluir o envio. Confira o bucket site-assets e as permissões de Storage e da tabela gallery. Detalhe: '+(error.message||'erro desconhecido'));
 }finally{
  if(botao){botao.disabled=false;botao.textContent='ENVIAR FOTOS';}
 }
}

async function listarGaleriaAdmin(){
 const area=$('adminGaleria');if(!area)return;
 const {data,error}=await db.from('gallery').select('id,caption,active').order('sort_order');
 if(error){area.textContent='Não foi possível listar as fotos.';return;}
 area.innerHTML='';
 (data||[]).forEach(item=>{
  const row=document.createElement('div');row.className='admin-service-row';
  const label=document.createElement('span');label.textContent=(item.caption||'Foto')+(item.active?' · Publicada':' · Oculta');
  const toggle=document.createElement('button');toggle.type='button';toggle.className='btn';toggle.textContent=item.active?'OCULTAR':'PUBLICAR';
  toggle.onclick=async()=>{
   const {error:updateError}=await db.from('gallery').update({active:!item.active}).eq('id',item.id);
   if(updateError){alert('Não foi possível alterar a foto.');return;}
   await carregarGaleria();await listarGaleriaAdmin();
  };
  row.append(label,toggle);area.append(row);
 });
}

async function uploadFotoAnna(){
 const file=$('annaProfileFile').files[0];
 if(!file){alert('Escolha uma foto da Anna primeiro.');return;}
 if(!file.type.startsWith('image/')){alert('Selecione um arquivo de imagem.');return;}
 if(file.size>5*1024*1024){alert('A foto deve ter no máximo 5 MB.');return;}
 const {data:sessionData}=await db.auth.getSession();
 if(!sessionData?.session){alert('Entre na área administrativa antes de enviar a foto.');return;}
 const path='anna-profile.jpg';
 const {error}=await db.storage.from('site-assets').upload(path,file,{upsert:true,contentType:file.type});
 if(error){console.error(error);alert('Falha ao enviar. Crie no Supabase Storage um bucket público chamado site-assets e permita upload/atualização para usuários autenticados.');return;}
 const {data}=db.storage.from('site-assets').getPublicUrl(path);
 const url=data.publicUrl+'?v='+Date.now();
 const photo=$('annaProfilePhoto');if(photo)photo.src=url;
 alert('Foto de perfil atualizada para todos os visitantes!');
}

async function carregarFotoPerfil(){
 try{
  const {data}=db.storage.from('site-assets').getPublicUrl('anna-profile.jpg');
  if(data?.publicUrl && $('annaProfilePhoto')) $('annaProfilePhoto').src=data.publicUrl+'?v='+Date.now();
 }catch(e){}
}

carregarFotoPerfil();
iniciar();
</script>
